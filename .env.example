# Spring Boot does not automatically load this file. Set these in your shell/IDE.
DB_URL=jdbc:postgresql://localhost:5432/uteexpress
DB_USERNAME=your_local_database_user
DB_PASSWORD=replace_with_your_local_password
JWT_SECRET_BASE64=replace_with_base64_32_byte_secret
# Optional for localhost HTTP only; production forces secure cookies.
JWT_COOKIE_SECURE=false
OTP_PEPPER_BASE64=replace_with_base64_32_byte_secret
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace_me
MAIL_PASSWORD=replace_me
MAIL_FROM=no-reply@example.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
UPLOAD_DIR=./var/uploads
# Optional: SPRING_PROFILES_ACTIVE=local or prod

# PAY-03: VNPAY Sandbox only. Enable after setting credentials in Render Environment.
# Use existing TMN_CODE / HASH_SECRET names, or VNPAY_TMN_CODE / VNPAY_HASH_SECRET.
VNPAY_ENABLED=false
TMN_CODE=replace_with_sandbox_merchant_code
HASH_SECRET=replace_with_sandbox_hash_secret
VNPAY_RETURN_URL=https://uteexpress-web.onrender.com/payments/vnpay/return
# Register IPN URL in the VNPAY Sandbox merchant configuration (not a payment URL parameter):
# https://uteexpress-web.onrender.com/payments/vnpay/ipn
